---
import MediaFrame from './MediaFrame.astro';

/**
 * One entry in the homepage exhibition.
 *
 * The composition comes from the project's own `layout` + `align`, so no two
 * neighbours are framed the same way (§06, §33, §34). The curator changes the
 * frame; the interface underneath stays identical.
 */
const { project, index } = Astro.props;
const { number, slug, client, category, variant, statement, media, layout, align, dark } = project;

const href = `/work/${slug}`;
const cursorLabel = media.kind === 'image' ? 'View' : 'Play';
// The hero on the project page carries the same name, so the thumbnail
// expands into it rather than cutting (§13).
const transitionName = `media-${slug}`;
// The first two blocks sit near the fold; everything after can wait.
const eager = index < 1;
---

<article class="block" data-layout={layout} data-align={align} data-dark={dark ? '' : undefined}>
  <a class="block__link" href={href} data-cursor-label-text={cursorLabel}>
    <span class="visually-hidden">{client} — {category}. View project.</span>
  </a>

  <div class="block__media reveal">
    <MediaFrame media={media} transitionName={transitionName} eager={eager} sizes="(max-width: 60rem) 100vw, 60vw" />
  </div>

  <div class="block__text reveal">
    <p class="numeral block__number">{number}</p>

    <h3 class="display block__statement">{statement}</h3>

    <p class="meta block__client">{client}{variant ? ` — ${variant}` : ''}</p>
    <p class="meta block__category">{category}</p>

    <p class="meta meta--ink block__cta" aria-hidden="true">View project <span>&#8599;</span></p>
  </div>
</article>

<style>
  .block {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem) var(--gutter);
    align-items: end;
    padding-block: var(--rhythm);
    padding-inline: var(--gutter);
  }

  /* One link covers the block so the whole composition is the target, while
     the visible type stays plain text and the cursor label still resolves. */
  .block__link {
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  .block__media {
    grid-column: 1 / -1;
    min-width: 0;
  }

  .block__text {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.35rem;
    align-content: end;
  }

  .block__number {
    color: var(--mute);
    margin-bottom: 0.15em;
  }

  /* Statements carry their own line breaks, so the width only has to be wide
     enough not to re-break them, and `balance` must stay out of it. */
  .block__statement {
    font-size: var(--t-md);
    white-space: pre-line;
    text-wrap: normal;
    margin-bottom: 0.5em;
    max-width: 30ch;
  }

  .block__client {
    color: var(--fg);
    font-weight: 600;
  }

  .block__cta {
    margin-top: 1.25rem;
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .block:hover .block__cta,
  .block:focus-within .block__cta {
    opacity: 1;
    transform: none;
  }

  .block :global(.frame) {
    transition: scale 1.1s var(--ease);
  }

  /* Slow, small, deliberate — never a pop (§24). */
  .block:hover :global(.frame),
  .block:focus-within :global(.frame) {
    scale: 1.012;
  }

  /* A dark project becomes a dark band inside the light page. Swapping the
     four tokens re-colours the type, rules and metadata inside it with no
     further rules (§33). */
  .block[data-dark] {
    --bg: #0a0a0a;
    --fg: #f3f1ec;
    --line: #2b2a28;

    background: var(--bg);
    color: var(--fg);
  }

  /* ---- Compositions. Desktop only; mobile gets its own rhythm below. ---- */

  @media (min-width: 60rem) {
    /* inset — small, deeply indented, mostly air */
    .block[data-layout='inset'][data-align='left'] .block__media {
      grid-column: 2 / 6;
    }
    .block[data-layout='inset'][data-align='left'] .block__text {
      grid-column: 8 / 12;
    }
    .block[data-layout='inset'][data-align='right'] .block__media {
      grid-column: 8 / 12;
    }
    .block[data-layout='inset'][data-align='right'] .block__text {
      grid-column: 2 / 6;
      text-align: right;
      justify-items: end;
    }

    /* edge — media runs off one side of the viewport */
    .block[data-layout='edge'] {
      align-items: center;
    }
    .block[data-layout='edge'][data-align='right'] {
      padding-right: 0;
    }
    .block[data-layout='edge'][data-align='right'] .block__media {
      grid-column: 6 / -1;
      margin-right: calc(var(--gutter) * -1);
    }
    .block[data-layout='edge'][data-align='right'] .block__text {
      grid-column: 1 / 5;
    }
    .block[data-layout='edge'][data-align='left'] {
      padding-left: 0;
    }
    .block[data-layout='edge'][data-align='left'] .block__media {
      grid-column: 1 / 8;
      margin-left: calc(var(--gutter) * -1);
      order: -1;
    }
    .block[data-layout='edge'][data-align='left'] .block__text {
      grid-column: 9 / -1;
    }

    /* split — media and type share the width */
    .block[data-layout='split'] {
      align-items: center;
    }
    .block[data-layout='split'][data-align='left'] .block__media {
      grid-column: 1 / 7;
    }
    .block[data-layout='split'][data-align='left'] .block__text {
      grid-column: 8 / -1;
    }
    .block[data-layout='split'][data-align='right'] .block__media {
      grid-column: 7 / -1;
    }
    .block[data-layout='split'][data-align='right'] .block__text {
      grid-column: 1 / 6;
      order: -1;
    }

    /* stack — statement above, media below and offset */
    .block[data-layout='stack'] .block__text {
      grid-column: 1 / 9;
      order: -1;
      margin-bottom: clamp(1.5rem, 4vh, 3rem);
    }
    .block[data-layout='stack'] .block__statement {
      font-size: var(--t-lg);
    }
    .block[data-layout='stack'][data-align='left'] .block__media {
      grid-column: 1 / 10;
    }
    .block[data-layout='stack'][data-align='right'] .block__media {
      grid-column: 4 / -1;
    }
    .block[data-layout='stack'][data-align='right'] .block__text {
      grid-column: 4 / -1;
    }

    /* full — statement, then full-bleed film, then a caption rule */
    .block[data-layout='full'] {
      padding-inline: 0;
      gap: clamp(2rem, 5vh, 4rem) var(--gutter);
    }
    .block[data-layout='full'] .block__media {
      grid-column: 1 / -1;
      order: 0;
    }
    .block[data-layout='full'] .block__text {
      order: -1;
      grid-column: 2 / 11;
      padding-inline: var(--gutter);
    }
    .block[data-layout='full'][data-align='right'] .block__text {
      grid-column: 4 / -2;
    }
    .block[data-layout='full'] .block__statement {
      font-size: var(--t-lg);
    }
  }

  /* ---- Mobile: designed, not stacked (§27). Type stays oversized, the
     film keeps the full width, air is preserved. ---- */

  @media (max-width: 59.99rem) {
    .block {
      gap: 1.5rem;
      padding-block: clamp(3.5rem, 12vh, 6rem);
    }

    .block__text {
      order: -1;
    }

    .block__statement {
      font-size: var(--t-md);
    }

    /* Alternating indents keep the rhythm from flattening on a phone. */
    .block[data-align='right'] .block__text {
      justify-items: end;
      text-align: right;
    }

    .block[data-layout='inset'] .block__media {
      grid-column: 1 / 11;
    }

    .block[data-layout='inset'][data-align='right'] .block__media {
      grid-column: 3 / -1;
    }

    .block[data-layout='edge'][data-align='right'] {
      padding-right: 0;
    }

    .block[data-layout='edge'][data-align='left'] {
      padding-left: 0;
    }

    .block[data-layout='full'] {
      padding-inline: 0;
    }

    .block[data-layout='full'] .block__text {
      padding-inline: var(--gutter);
    }

    .block__cta {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // §13 — the clicked artwork is the only element that needs a transition name,
  // and it only needs it for the moment the navigation starts. Naming it on
  // click keeps every other film off its own compositor layer while browsing.
  document.querySelectorAll('.block__link').forEach((link) => {
    link.addEventListener('click', () => {
      const media = link.parentElement?.querySelector('[data-vt]');
      if (media instanceof HTMLElement && media.dataset.vt) {
        media.style.viewTransitionName = media.dataset.vt;
      }
    });
  });
</script>
